config/*.gam_params.csv
config/*.opcodes.json
config/*.up_opcodes.json
config/*.up_opcode_writes.json

# Headless Ghidra evidence runs are reproducible scratch. Logs, projects,
# exports, and decompiled bodies must never be published.
tools/ghidra/logs/
_safe/

